<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Video surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:use_controller="false"
        app:resize_mode="zoom" />

    <!-- Status bar -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#66000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Не подключено"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="192.168.1.1"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Left stick (Throttle + Yaw) -->
    <com.k9drone.app.JoystickView
        android:id="@+id/joystickLeft"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_margin="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Right stick (Pitch + Roll) -->
    <com.k9drone.app.JoystickView
        android:id="@+id/joystickRight"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_margin="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Control buttons column (right side) -->
    <LinearLayout
        android:id="@+id/btnColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/statusBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/joystickRight"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTakeoff"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Взлёт" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLand"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Посадка" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmergency"
            style="@style/Widget.Material3.Button"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:backgroundTint="#CC0000"
            android:text="STOP"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCameraSwitch"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Камера ↕" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalibrate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="Калибровка" />
    </LinearLayout>

    <!-- Tilt controls (left side) -->
    <LinearLayout
        android:id="@+id/tiltColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/statusBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/joystickLeft"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Наклон"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTiltUp"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="▲ UP" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTiltDown"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="▼ DN" />
    </LinearLayout>

    <!-- Connect button (center top) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConnect"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Подключить"
        app:layout_constraintTop_toBottomOf="@id/statusBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
